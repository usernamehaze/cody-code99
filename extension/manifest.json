{
  "manifest_version": 3,
  "name": "Cody \u00b7 Study Buddy",
  "short_name": "Cody",
  "version": "1.0.0",
  "description": "Turn any page or highlighted text into a Cody reviewer, quiz and flashcards, or ask Cody to draw it.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cody",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    }
  }
}
